# libFuzzer dictionary for sql_validate. Not a language model of SQL — just the
# tokens the validator DECIDES on, so mutation can reach a verdict boundary
# instead of spelling `INSERT` one byte at a time.
#
# ONE token per line. libFuzzer parses this file LINE by line: several quoted
# tokens on one line are read as a single garbage entry, not as several. The
# `fuzz run` banner prints the count ("Dictionary: N entries") — it must equal
# the number of token lines below, or the file is being misread again.

# allowlist heads
"SELECT "
"WITH "
"VALUES "
"EXPLAIN "
"SHOW "
"DESCRIBE "
"DESC "
"TABLE "

# write verbs (must always be refused)
"INSERT "
"UPDATE "
"DELETE "
"MERGE "
"REPLACE "
"TRUNCATE "
"CREATE "
"ALTER "
"DROP "
"GRANT "
"REVOKE "
"CALL "
"COPY "
"SET "
"PRAGMA "
"VACUUM "
"ANALYZE "
"ATTACH "
"LOAD "
"INTO "
"RETURNING "

# transaction control
"BEGIN"
"COMMIT"
"ROLLBACK"
"SAVEPOINT"
"START TRANSACTION"

# locking clauses
"FOR UPDATE"
"FOR SHARE"
"FOR NO KEY UPDATE"
"LOCK IN SHARE MODE"
"NOWAIT"

# clause skeleton
" FROM "
" WHERE "
" JOIN "
" ON "
" GROUP BY "
" HAVING "
" ORDER BY "
" LIMIT "
" OFFSET "
" UNION "
" UNION ALL "
" INTERSECT "
" EXCEPT "
" AS "
" RECURSIVE "
" OVER "
" PARTITION BY "
" WINDOW "
" LATERAL "
" CASE "
" WHEN "
" CAST "

# denied / catalog surface
"pg_read_file"
"pg_sleep"
"dblink"
"lo_import"
"load_extension"
"readfile"
"sys_exec"
"information_schema."
"pg_catalog."
"sqlite_master"
"pg_stats"
"mysql.user"
"current_setting"
"LOAD_FILE"

# comment and statement punctuation the normalizer has to survive
"--"
"/*"
"*/"
"/*!"
"/*+"
";"
"#"
"$$"
"$tag$"
"\""
"'"
"``"
"\\"
"\x00"
"E'"
"N'"
"0x"
"::"
"?"
"$1"
":name"
"@var"
